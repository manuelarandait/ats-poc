{% extends 'base.html.twig' %}

{% block title %}{{ offer.title }}{% endblock %}

{% block body %}
    <a href="{{ path('jobs_index') }}" class="link inline-flex items-center gap-1.5 text-sm"><twig:Icon name="arrow-left" /> All positions</a>

    <div class="mt-4 grid gap-8 lg:grid-cols-5">
        {# The description stays in view while the (longer) form is being filled. #}
        <article class="lg:sticky lg:top-6 lg:col-span-2 lg:self-start">
            <h1 class="text-2xl font-semibold">{{ offer.title }}</h1>
            {# Paragraphs like "Requirements: a, b, c." become a titled list; "Nice to have" a set of tags. #}
            <div class="mt-4 space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                {% for paragraph in offer.description|split("\n\n")|map(p => p|trim)|filter(p => p is not empty) %}
                    {% if paragraph matches '/^[A-Z][A-Za-z ]{2,30}: /' %}
                        {% set label = paragraph|split(': ', 2)|first %}
                        {% set items = paragraph|split(': ', 2)|last|trim('.')|split(', ') %}
                        <section>
                            <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ label }}</h2>
                            {% if 'nice' in label|lower %}
                                <ul class="mt-2 flex flex-wrap gap-2">
                                    {% for item in items %}
                                        <li class="badge bg-slate-100 text-slate-700 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700">{{ item|first|upper ~ item|slice(1) }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <ul class="mt-2 space-y-1.5">
                                    {% for item in items %}
                                        <li class="flex gap-2"><twig:Icon name="check" class="mt-0.5 size-4 text-indigo-600 dark:text-indigo-400" />{{ item|first|upper ~ item|slice(1) }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    {% elseif loop.first %}
                        <p class="text-base text-slate-900 dark:text-slate-100">{{ paragraph }}</p>
                    {% else %}
                        <p>{{ paragraph }}</p>
                    {% endif %}
                {% endfor %}
            </div>
        </article>

        <section class="card p-6 lg:col-span-3" aria-labelledby="apply-title">
            <h2 id="apply-title" class="text-lg font-medium">Apply for this position</h2>
            <p class="meta mt-1">Fields marked * are required. We'll analyse your CV right after you apply.</p>

            {{ form_start(form, {attr: {class: 'mt-6 space-y-5', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="grid gap-5 sm:grid-cols-2">
                    <div class="sm:col-span-2">{{ form_row(form.fullName) }}</div>
                    {{ form_row(form.email) }}
                    {{ form_row(form.phone) }}
                </div>

                <div data-controller="char-counter" data-char-counter-max-value="{{ constant('App\\Recruitment\\Domain\\JobApplication\\CvText::MAX_LENGTH') }}">
                    {{ form_row(form.cv) }}
                    <p class="meta mt-1 text-right tabular-nums" data-char-counter-target="count" aria-live="polite"></p>
                </div>

                {{ form_row(form.notes) }}

                <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-slate-800">
                    <a href="{{ path('jobs_index') }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Submit application</button>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
