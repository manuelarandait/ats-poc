{#
    A job offer's plain-text description, structured for reading: the first
    paragraph is the pitch, "Label: a, b, c." paragraphs become a titled list
    and "Nice to have" a set of tags.
    Usage: <twig:JobDescription :description="offer.description" />
#}
{% props description %}
<div {{ attributes.defaults({class: 'space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300'}) }}>
    {% for paragraph in description|split("\n\n")|map(p => p|trim)|filter(p => p is not empty) %}
        {% if paragraph matches '/^[A-Z][A-Za-z ]{2,30}: /' %}
            {% set label = paragraph|split(': ', 2)|first %}
            {% set items = paragraph|split(': ', 2)|last|trim('.')|split(', ') %}
            <section>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ label }}</h3>
                {% if 'nice' in label|lower %}
                    <ul class="mt-2 flex flex-wrap gap-2">
                        {% for item in items %}
                            <li class="badge bg-slate-100 text-slate-700 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700">{{ item|first|upper ~ item|slice(1) }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <ul class="mt-2 space-y-1.5">
                        {% for item in items %}
                            {# A neutral bullet, not a check: next to the AI screening, a check means "found in the CV". #}
                            <li class="flex gap-2.5"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-indigo-500 dark:bg-indigo-400" aria-hidden="true"></span>{{ item|first|upper ~ item|slice(1) }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% elseif loop.first %}
            <p class="text-base text-slate-900 dark:text-slate-100">{{ paragraph }}</p>
        {% else %}
            <p>{{ paragraph }}</p>
        {% endif %}
    {% endfor %}
</div>
