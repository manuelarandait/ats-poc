{# Small presentational components. Import with: {% import 'components/ui.html.twig' as ui %} #}

{% macro status_badge(status) %}
    {% set styles = {
        received: 'bg-slate-100 text-slate-700 ring-slate-300 dark:bg-slate-500/15 dark:text-slate-300 dark:ring-slate-500/30',
        in_review: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-500/15 dark:text-sky-300 dark:ring-sky-500/30',
        interviewing: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-500/15 dark:text-violet-300 dark:ring-violet-500/30',
        hired: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:ring-emerald-500/30',
        rejected: 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:ring-rose-500/30',
    } %}
    <span class="badge {{ styles[status] ?? styles.received }}">{{ status|replace({'_': ' '})|capitalize }}</span>
{% endmacro %}

{% macro screening_badge(status) %}
    {% if status == 'pending' %}
        <span class="badge bg-indigo-50 text-indigo-700 ring-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:ring-indigo-500/30">
            <span class="size-1.5 rounded-full bg-current motion-safe:animate-pulse" aria-hidden="true"></span>
            Analysing…
        </span>
    {% elseif status == 'failed' %}
        <span class="badge bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/30">AI unavailable</span>
    {% endif %}
{% endmacro %}

{% macro score(score, screeningStatus = 'completed') %}
    {% if score is not null %}
        {% set tone = score >= 70
            ? 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:ring-emerald-500/30'
            : (score >= 40
                ? 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/30'
                : 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:ring-rose-500/30') %}
        <span class="badge {{ tone }} tabular-nums" title="AI relevance score">{{ score }}<span class="sr-only"> out of 100</span></span>
    {% else %}
        {{ _self.screening_badge(screeningStatus) }}
    {% endif %}
{% endmacro %}

{% macro empty_state(title, text, actionUrl = null, actionLabel = null) %}
    <div class="px-6 py-16 text-center">
        <p class="text-base font-medium text-slate-900 dark:text-slate-100">{{ title }}</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ text }}</p>
        {% if actionUrl %}
            <a href="{{ actionUrl }}" class="btn btn-secondary mt-6" data-turbo-frame="_top">{{ actionLabel }}</a>
        {% endif %}
    </div>
{% endmacro %}

{% macro time(date) %}
    <time datetime="{{ date|date('c') }}" title="{{ date|date('M j, Y · H:i') }} UTC">{{ date|time_ago }}</time>
{% endmacro %}
