{# Hiring pipeline status. Usage: <twig:StatusBadge :status="application.status" /> #}
{% props status %}
{% set styles = {
    received: 'bg-slate-100 text-slate-700 ring-slate-300 dark:bg-slate-500/15 dark:text-slate-300 dark:ring-slate-500/30',
    in_review: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-500/15 dark:text-sky-300 dark:ring-sky-500/30',
    interviewing: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-500/15 dark:text-violet-300 dark:ring-violet-500/30',
    hired: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:ring-emerald-500/30',
    rejected: 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:ring-rose-500/30',
} %}
<span {{ attributes.defaults({class: 'badge ' ~ (styles[status] ?? styles.received)}) }}>{{ status|replace({'_': ' '})|capitalize }}</span>
