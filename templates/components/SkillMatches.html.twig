{#
    Skills a position asks for as chips: ✓ found in the CV, ✗ missing. A
    missing required skill reads as a gap (rose); a missing nice-to-have one
    stays neutral. The state is always written for screen readers, never
    colour alone.
    Usage: <twig:SkillMatches label="Required" :skills="application.requiredSkills" />
#}
{% props label, skills %}
{% set matched = skills|filter(s => s.matched)|length %}
<div {{ attributes }}>
    <h4 class="flex items-baseline gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
        {{ label }} <span class="font-normal normal-case tabular-nums">{{ matched }} of {{ skills|length }} in the CV</span>
    </h4>
    <ul class="mt-2 flex flex-wrap gap-1.5">
        {% for skill in skills %}
            {% if skill.matched %}
                {% set tone = 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:ring-emerald-500/30' %}
            {% elseif skill.required %}
                {% set tone = 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:ring-rose-500/30' %}
            {% else %}
                {% set tone = 'bg-slate-50 text-slate-500 ring-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-700' %}
            {% endif %}
            <li class="badge {{ tone }}">
                <twig:Icon :name="skill.matched ? 'check' : 'x'" class="size-3.5" stroke-width="2.5" />
                {{ skill.skill }}<span class="sr-only">: {{ skill.matched ? 'in the CV' : 'missing' }}</span>
            </li>
        {% endfor %}
    </ul>
</div>
