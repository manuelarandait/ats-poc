{% extends 'base.html.twig' %}
{% block title %}{{ application.candidateName }}{% endblock %}

{% block body %}
    <a href="{{ path('applications_index') }}" class="link inline-flex items-center gap-1.5 text-sm"><twig:Icon name="arrow-left" /> All applications</a>

    {# While the AI is analysing, this frame reloads itself until the result arrives. #}
    <turbo-frame id="application-detail" class="mt-4 block">
        <header class="card flex flex-wrap items-center gap-5 p-6">
            <twig:Avatar :name="application.candidateName" size="lg" />
            <div class="min-w-0 flex-1">
                <h1 class="text-2xl font-semibold">{{ application.candidateName }}</h1>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                    Applied for <a href="{{ path('jobs_show', {id: application.jobOfferId}) }}" data-turbo-frame="_top" class="font-medium text-slate-700 hover:text-indigo-600 dark:text-slate-200 dark:hover:text-indigo-300">{{ application.positionTitle }}</a> · <twig:Time :date="application.appliedAt" />
                </p>
                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                    <a href="mailto:{{ application.candidateEmail }}" class="link inline-flex items-center gap-1.5 break-all"><twig:Icon name="mail" />{{ application.candidateEmail }}</a>
                    {% if application.candidatePhone %}
                        <a href="tel:{{ application.candidatePhone }}" class="link inline-flex items-center gap-1.5"><twig:Icon name="phone" />{{ application.candidatePhone }}</a>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 text-slate-400"><twig:Icon name="phone" />No phone provided</span>
                    {% endif %}
                </div>
            </div>
            <div class="flex items-center gap-2" aria-live="polite">
                <twig:StatusBadge :status="application.status" />
                <twig:ScreeningBadge :status="application.screeningStatus" />
            </div>
        </header>

        <div class="mt-6 grid gap-6 lg:grid-cols-3">
            <div class="space-y-6 lg:col-span-2">
                <section class="card p-6" aria-labelledby="ai-title">
                    <h2 id="ai-title" class="flex items-center gap-2 text-lg font-medium"><twig:Icon name="sparkles" class="size-5 text-indigo-500" /> AI screening</h2>

                    <div aria-live="polite">
                        {% if application.screeningStatus == 'completed' %}
                            <div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-center">
                                {% if application.aiScore is not null %}
                                    <twig:ScoreRing :score="application.aiScore" />
                                {% endif %}
                                <div>
                                    <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Summary</h3>
                                    <p class="mt-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">{{ application.aiSummary }}</p>
                                </div>
                            </div>
                            {# The fit for the position, skill by skill (absent for analyses made before the breakdown existed). #}
                            {% if application.aiSkills is not empty %}
                                <div class="mt-5 space-y-4 border-t border-slate-200 pt-5 dark:border-slate-800">
                                    <twig:SkillMatches label="Required" :skills="application.requiredSkills" />
                                    {% if application.niceToHaveSkills is not empty %}
                                        <twig:SkillMatches label="Nice to have" :skills="application.niceToHaveSkills" />
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% elseif application.screeningStatus == 'pending' %}
                            <div class="mt-4 flex items-center gap-5" aria-hidden="true">
                                <div class="size-24 shrink-0 rounded-full border-8 border-slate-200 motion-safe:animate-pulse dark:border-slate-800"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-3 w-full rounded bg-slate-200 motion-safe:animate-pulse dark:bg-slate-800"></div>
                                    <div class="h-3 w-5/6 rounded bg-slate-200 motion-safe:animate-pulse dark:bg-slate-800"></div>
                                    <div class="h-3 w-2/3 rounded bg-slate-200 motion-safe:animate-pulse dark:bg-slate-800"></div>
                                </div>
                            </div>
                            <p class="meta mt-4">The AI assistant is analysing this CV. This page updates by itself.</p>
                        {% else %}
                            <p class="mt-3 flex gap-2 text-sm text-slate-600 dark:text-slate-400"><twig:Icon name="info" class="mt-0.5" /> The AI analysis couldn't be completed. The CV is still available below for manual review.</p>
                        {% endif %}
                    </div>
                </section>

                {# The offer, folded: the skill chips above already sum up what it asks for. #}
                <twig:CollapsibleCard id="position" title="Position · {{ application.positionTitle }}">
                    <twig:JobDescription :description="application.positionDescription" class="mt-4" />
                    <a href="{{ path('jobs_show', {id: application.jobOfferId}) }}" data-turbo-frame="_top" class="link mt-5 inline-flex items-center gap-1 text-sm">Open the job page <twig:Icon name="arrow-right" class="size-4" /></a>
                </twig:CollapsibleCard>

                {# What the recruiter came to read: open, but it can be folded away. #}
                <twig:CollapsibleCard id="cv" title="CV" :open="true">
                    <pre class="mt-3 max-h-[32rem] overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 font-mono text-sm leading-relaxed text-slate-800 dark:bg-slate-950 dark:text-slate-200">{{ application.cv }}</pre>
                </twig:CollapsibleCard>

                {% if application.notes %}
                    <section class="card p-6" aria-labelledby="notes-title">
                        <h2 id="notes-title" class="text-lg font-medium">Notes from the candidate</h2>
                        <p class="mt-3 whitespace-pre-line text-sm text-slate-700 dark:text-slate-300">{{ application.notes }}</p>
                    </section>
                {% endif %}
            </div>

            <aside class="space-y-6">
                <section class="card p-6" aria-labelledby="status-title">
                    <h2 id="status-title" class="text-lg font-medium">Status</h2>
                    <twig:Pipeline :status="application.status" class="mt-4" />
                    {% if application.nextStatuses is not empty %}
                        {# One button per allowed move: advancing is the primary action, rejecting asks for confirmation. #}
                        <form action="{{ path('applications_change_status', {id: application.id}) }}" method="post" data-turbo-frame="_top" class="mt-5 space-y-2" data-controller="confirm">
                            <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ application.id) }}">
                            {% for status in application.nextStatuses|filter(s => s != 'rejected') %}
                                <button type="submit" name="status" value="{{ status }}" class="btn btn-primary w-full">Move to {{ status|replace({'_': ' '}) }}</button>
                            {% endfor %}
                            {% if 'rejected' in application.nextStatuses %}
                                <button type="submit" name="status" value="rejected" class="btn btn-secondary w-full text-rose-700 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-500/10"
                                        data-confirm-target="trigger" data-action="confirm#ask">Reject</button>
                                <div hidden class="rounded-lg border border-rose-200 bg-rose-50 p-3 dark:border-rose-500/30 dark:bg-rose-500/10"
                                     data-confirm-target="panel" data-action="keydown.esc->confirm#cancel">
                                    <p id="reject-warning" class="text-sm text-rose-800 dark:text-rose-200">Reject {{ application.candidateName }}? This can't be undone.</p>
                                    <div class="mt-3 flex gap-2">
                                        <button type="submit" name="status" value="rejected" class="btn btn-danger flex-1" aria-describedby="reject-warning" data-confirm-target="confirm">Yes, reject</button>
                                        <button type="button" class="btn btn-secondary flex-1" data-action="confirm#cancel">Cancel</button>
                                    </div>
                                </div>
                            {% endif %}
                        </form>
                    {% else %}
                        <p class="meta mt-4">Final status: no further changes.</p>
                    {% endif %}
                </section>

                {% if application.otherApplications is not empty %}
                    <section class="card p-6" aria-labelledby="other-title">
                        <h2 id="other-title" class="text-lg font-medium">Other applications</h2>
                        <p class="meta mt-1">Sent from the same email address, which isn't verified.</p>
                        <ul class="mt-4 divide-y divide-slate-200 dark:divide-slate-800">
                            {% for other in application.otherApplications %}
                                <li class="py-3 first:pt-0 last:pb-0">
                                    <a href="{{ path('applications_show', {id: other.id}) }}" data-turbo-frame="_top" class="link text-sm">{{ other.positionTitle }}</a>
                                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                                        <twig:StatusBadge :status="other.status" />
                                        <twig:Score :score="other.aiScore" :screeningStatus="other.screeningStatus" />
                                        <twig:Time :date="other.appliedAt" class="meta" />
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                <section class="card p-6" aria-labelledby="timeline-title">
                    <h2 id="timeline-title" class="text-lg font-medium">Timeline</h2>
                    <dl class="mt-3 space-y-3 text-sm">
                        <div><dt class="meta">Applied</dt><dd class="tabular-nums">{{ application.appliedAt|date('M j, Y · H:i') }} UTC</dd></div>
                        <div><dt class="meta">AI screened</dt><dd class="tabular-nums">{{ application.screenedAt ? application.screenedAt|date('M j, Y · H:i') ~ ' UTC' : '—' }}</dd></div>
                        <div><dt class="meta">Last updated</dt><dd class="tabular-nums">{{ application.updatedAt|date('M j, Y · H:i') }} UTC</dd></div>
                    </dl>
                </section>
            </aside>
        </div>

        {% if application.screeningStatus == 'pending' %}
            <div hidden data-controller="poll" data-poll-url-value="{{ path('applications_show', {id: application.id}) }}"></div>
        {% endif %}
    </turbo-frame>
{% endblock %}
