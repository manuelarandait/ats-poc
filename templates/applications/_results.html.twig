{% set hasFilters = filters.q or filters.status or filters.position %}

{# advance: the URL follows the filters, so results are shareable and Back works. #}
<turbo-frame id="{{ frame }}" data-turbo-action="advance" class="block transition-opacity aria-busy:opacity-60">
    <div class="card overflow-hidden">
        {% if page.items is empty %}
            {% if hasFilters %}
                <twig:EmptyState title="No applications match these filters" text="Try another search or clear the filters." :actionUrl="path('applications_index')" actionLabel="Clear filters" />
            {% else %}
                <twig:EmptyState title="No applications yet" text="Share an open position to receive the first one." :actionUrl="path('jobs_index')" actionLabel="See open positions" />
            {% endif %}
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="sticky top-0 bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                        <tr>
                            <th scope="col" class="px-4 py-3">Candidate</th>
                            <th scope="col" class="hidden px-4 py-3 md:table-cell">Position</th>
                            <th scope="col" class="px-4 py-3">Status</th>
                            <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">AI score</th>
                            <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">Applied</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                        {% for item in page.items %}
                            <tr class="relative transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/50">
                                <td class="px-4 py-3">
                                    {# The link covers the whole row. #}
                                    <a href="{{ path('applications_show', {id: item.id}) }}" data-turbo-frame="_top"
                                       class="font-medium text-slate-900 after:absolute after:inset-0 focus-visible:outline-none dark:text-slate-100">{{ item.candidateName }}</a>
                                    <div class="meta">{{ item.candidateEmail }}</div>
                                </td>
                                <td class="hidden px-4 py-3 text-slate-600 md:table-cell dark:text-slate-300">{{ item.positionTitle }}</td>
                                <td class="px-4 py-3">
                                    <twig:StatusBadge :status="item.status" />
                                    {# On small screens the score sits under the status instead of its own column. #}
                                    <div class="mt-1.5 sm:hidden"><twig:Score :score="item.aiScore" :screeningStatus="item.screeningStatus" /></div>
                                </td>
                                <td class="hidden px-4 py-3 text-right sm:table-cell"><twig:Score :score="item.aiScore" :screeningStatus="item.screeningStatus" /></td>
                                <td class="meta hidden px-4 py-3 text-right tabular-nums sm:table-cell"><twig:Time :date="item.appliedAt" /></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <twig:Pagination :page="page" route="applications_index" :params="linkParams"
                             :perPageOptions="perPageOptions" formId="applications-filters" />
        {% endif %}
    </div>

    {# Keep refreshing while any visible application is still being analysed. #}
    {% if page.items|filter(i => i.screeningStatus == 'pending')|length %}
        <div hidden data-controller="poll" data-poll-url-value="{{ path('applications_index', linkParams|merge({page: page.page})) }}"></div>
    {% endif %}
</turbo-frame>
