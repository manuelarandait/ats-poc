<!DOCTYPE html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Turbo animates page changes with the View Transitions API where supported (no-op elsewhere). #}
        <meta name="view-transition" content="same-origin">
        <title>{% block title %}ATS{% endblock %} · ATS PoC</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%234f46e5%22/><path d=%22M9 11h14M11.5 16h9M14 21h4%22 stroke=%22white%22 stroke-width=%222.5%22 stroke-linecap=%22round%22/></svg>">
        {# Applies the saved theme (or the OS preference) before the first paint. #}
        <script>
            (() => {
                let theme = null;
                try { theme = localStorage.getItem('theme'); } catch (e) {}
                const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.classList.toggle('dark', dark);
            })();
        </script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex min-h-full flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
        {% set section = app.request.attributes.get('_route')|default('')|split('_')|first %}
        <header style="view-transition-name: site-header" class="border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-900/80">
            <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
                <a href="{{ path('jobs_index') }}" class="flex shrink-0 items-center gap-2 whitespace-nowrap font-semibold">
                    <twig:Logo />
                    <span>ATS <span class="font-normal text-slate-500 dark:text-slate-400">PoC</span></span>
                </a>
                {% set isRecruiter = is_granted('ROLE_RECRUITER') %}
                <div class="flex items-center gap-1 text-sm">
                    {% set links = isRecruiter ? {jobs_index: ['Jobs', 'briefcase'], applications_index: ['Applications', 'users']} : {jobs_index: ['Jobs', 'briefcase']} %}
                    {% for route, link in links %}
                        {% set active = section == route|split('_')|first %}
                        <a href="{{ path(route) }}"
                           class="inline-flex items-center gap-2 rounded-md px-3 py-1.5 font-medium transition-colors {{ active ? 'bg-slate-100 text-slate-900 dark:bg-slate-800 dark:text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-white' }}"
                           {% if active %}aria-current="page"{% endif %}><twig:Icon :name="link[1]" class="hidden size-4 sm:block" />{{ link[0] }}</a>
                    {% endfor %}
                </div>
                <div class="ml-auto flex items-center gap-3 text-sm">
                    {% if isRecruiter %}
                        <span class="hidden text-slate-500 md:inline dark:text-slate-400">{{ app.user.userIdentifier }}</span>
                        {# POST, not a link: Turbo prefetches links on hover, which would log you out. #}
                        <form method="post" action="{{ path('_logout_main') }}" data-turbo="false">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" data-controller="csrf-protection">
                            <button type="submit" class="inline-flex items-center gap-1.5 font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><twig:Icon name="logout" />Log out</button>
                        </form>
                    {% elseif section != 'login' %}
                        <a href="{{ path('login') }}" class="font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Recruiter login</a>
                    {% endif %}
                    <button type="button" class="btn btn-secondary !px-2.5" data-controller="theme" data-action="theme#toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                        <twig:Icon name="moon" class="size-4 dark:hidden" />
                        <twig:Icon name="sun" class="hidden size-4 dark:block" />
                    </button>
                </div>
            </nav>
        </header>

        {# Flash messages as toasts: they float over the page instead of pushing it down. #}
        {% set flashes = app.flashes %}
        {% if flashes is not empty %}
            <div class="pointer-events-none fixed inset-x-4 top-16 z-50 flex flex-col items-end gap-2 sm:left-auto sm:w-96" aria-live="polite">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div role="status" data-controller="toast" data-action="mouseenter->toast#pause mouseleave->toast#resume"
                             class="pointer-events-auto flex w-full items-start gap-3 rounded-xl border bg-white p-4 text-sm shadow-lg transition duration-300 motion-safe:starting:translate-y-2 starting:opacity-0 dark:bg-slate-900 {{ type == 'error' ? 'border-rose-200 dark:border-rose-500/30' : 'border-emerald-200 dark:border-emerald-500/30' }}">
                            {% if type == 'error' %}
                                <twig:Icon name="x-circle" class="size-5 text-rose-600 dark:text-rose-400" />
                            {% else %}
                                <twig:Icon name="check-circle" class="size-5 text-emerald-600 dark:text-emerald-400" />
                            {% endif %}
                            <p class="flex-1 pt-0.5 text-slate-700 dark:text-slate-200">{{ message }}</p>
                            <button type="button" class="-m-1 rounded-md p-1 text-slate-400 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:hover:text-slate-200"
                                    data-action="toast#dismiss" aria-label="Dismiss"><twig:Icon name="x" /></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
            {% block body %}{% endblock %}
        </main>

        <footer class="border-t border-slate-200 dark:border-slate-800">
            <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-xs text-slate-500 sm:px-6 dark:text-slate-400">
                <p class="flex items-center gap-2"><twig:Logo class="size-4" /> ATS PoC · a technical exercise</p>
                <p>Symfony · Turbo · Tailwind · AI screening is simulated</p>
            </div>
        </footer>
    </body>
</html>
