<!DOCTYPE html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Turbo animates page changes with the View Transitions API where supported (no-op elsewhere). #}
        <meta name="view-transition" content="same-origin">
        <title>{% block title %}ATS{% endblock %} · ATS PoC</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%234f46e5%22/><text x=%2216%22 y=%2222%22 font-size=%2216%22 text-anchor=%22middle%22 fill=%22white%22 font-family=%22sans-serif%22 font-weight=%22700%22>A</text></svg>">
        {# Applies the saved theme (or the OS preference) before the first paint. #}
        <script>
            (() => {
                let theme = null;
                try { theme = localStorage.getItem('theme'); } catch (e) {}
                const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.classList.toggle('dark', dark);
            })();
        </script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-full bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
        {% set section = app.request.attributes.get('_route')|default('')|split('_')|first %}
        <header style="view-transition-name: site-header" class="border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-900/80">
            <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
                <a href="{{ path('jobs_index') }}" class="flex shrink-0 items-center gap-2 whitespace-nowrap font-semibold">
                    <span class="grid size-7 place-items-center rounded-lg bg-indigo-600 text-sm text-white dark:bg-indigo-500" aria-hidden="true">A</span>
                    <span>ATS <span class="font-normal text-slate-500 dark:text-slate-400">PoC</span></span>
                </a>
                {% set isRecruiter = is_granted('ROLE_RECRUITER') %}
                <div class="flex items-center gap-1 text-sm">
                    {% set links = isRecruiter ? {jobs_index: 'Jobs', applications_index: 'Applications'} : {jobs_index: 'Jobs'} %}
                    {% for route, label in links %}
                        {% set active = section == route|split('_')|first %}
                        <a href="{{ path(route) }}"
                           class="rounded-md px-3 py-1.5 font-medium {{ active ? 'bg-slate-100 text-slate-900 dark:bg-slate-800 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white' }}"
                           {% if active %}aria-current="page"{% endif %}>{{ label }}</a>
                    {% endfor %}
                </div>
                <div class="ml-auto flex items-center gap-3 text-sm">
                    {% if isRecruiter %}
                        <span class="hidden text-slate-500 md:inline dark:text-slate-400">{{ app.user.userIdentifier }}</span>
                        {# POST, not a link: Turbo prefetches links on hover, which would log you out. #}
                        <form method="post" action="{{ path('_logout_main') }}" data-turbo="false">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" data-controller="csrf-protection">
                            <button type="submit" class="font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Log out</button>
                        </form>
                    {% elseif section != 'login' %}
                        <a href="{{ path('login') }}" class="font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Recruiter login</a>
                    {% endif %}
                    <button type="button" class="btn btn-secondary !px-2.5" data-controller="theme" data-action="theme#toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                </div>
            </nav>
        </header>

        <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div role="status" class="mb-6 rounded-lg border px-4 py-3 text-sm {{ type == 'error'
                        ? 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200'
                        : 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-200' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
