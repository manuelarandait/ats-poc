<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="App\Recruitment\Domain\JobApplication\Candidate\Candidate">
        <field name="fullName" type="full_name" length="150"/>
        <field name="email" type="email" length="254"/>
        <field name="phone" type="phone" length="20" nullable="true"/>
    </embeddable>
</doctrine-mapping>
